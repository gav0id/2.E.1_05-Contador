public class Contador {

    int valor;

    public Contador(int valor) {
        this.valor = valor;
    }

    public Contador() {
        this.valor = 0;
    }

    public void incrementar() {
        valor = valor + 1;
    }

    public void decrementar() {
        if (valor == 0) {
            valor = 0;
        } else {
            valor = valor - 1;
        }
    }
    public void resetear(){
        valor= 0;
    }
    public int getValor(){
        return valor;
    }
}


public class Main {
    public static void main(String[] args) {
        Contador contador1 = new Contador();
        System.out.println("Valor inicial: " + contador1.getValor());

        contador1.incrementar();
        contador1.incrementar();
        System.out.println("Tras incrementar dos veces: " + contador1.getValor());

        contador1.decrementar();
        System.out.println("Tras decrementar una vez: " + contador1.getValor());

        contador1.decrementar();
        contador1.decrementar();
        System.out.println("Tras intentar decrementar por debajo de cero: " + contador1.getValor());

        Contador contador2 = new Contador(5);
        System.out.println("Valor inicial (parametrizado en 5): " + contador2.getValor());

        contador2.resetear();
        System.out.println("Tras aplicar resetear al segundo contador: " + contador2.getValor());
    }
}
